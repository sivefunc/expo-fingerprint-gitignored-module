{
  "expo": {
    "name": "expo-fingerprint-gitignored-module",
    "slug": "expo-fingerprint-gitignored-module",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.gitignoredmodule"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.example.gitignoredmodule"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://updates.example.com/manifest",
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "./plugins/withSharedAttributes"
    ]
  }
}
